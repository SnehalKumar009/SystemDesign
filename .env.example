# Copy to .env and fill in. Never commit real keys.

# Cloud LLM key for consolidated notes (matches llm.cloud.api_key_env in config.yaml).
OPENAI_API_KEY=

# If using Anthropic instead (set llm.cloud.provider: anthropic in config.yaml).
ANTHROPIC_API_KEY=

# Compose project name -> isolates network + volumes per subject.
COMPOSE_PROJECT_NAME=system_design

# Host Ollama endpoint. In Docker, the app reaches the host via host.docker.internal.
# Native (non-Docker) runs use http://localhost:11434.
OLLAMA_HOST=http://host.docker.internal:11434
